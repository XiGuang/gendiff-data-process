# Python-generated files
__pycache__/
*.py[cod]
build/
dist/
wheels/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local environments and editor state
/.venv/
/.vscode/
/.codex

# Data and generated artifacts are kept outside Git
/data/
/output/
/outputs/
