# Historical generated dataset indexes (cataloged, not source configuration)
/config/
/data.yaml
/pipeline/pairs_t1_t2.yaml

# Large binary artifacts must be referenced by catalog manifests
*.obj
*.mtl
*.ply
*.pt
*.npz
*.png
*.jpg
*.jpeg
